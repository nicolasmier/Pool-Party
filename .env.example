# ─── Base de datos ───────────────────────────────────────────────
DATABASE_URL="postgresql://localsports:localsports@localhost:5432/localsports?schema=public"

# ─── API ─────────────────────────────────────────────────────────
API_PORT=3001
NODE_ENV=development

# ─── Auth ────────────────────────────────────────────────────────
JWT_ACCESS_SECRET="cambia-esto-en-produccion"
JWT_REFRESH_SECRET="cambia-esto-tambien"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"

# ─── Frontends (URLs públicas) ───────────────────────────────────
NEXT_PUBLIC_API_URL="http://localhost:3001"
CORS_ORIGINS="http://localhost:3000,http://localhost:3002,http://localhost:3003"

