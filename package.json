{
  "name": "localsports",
  "version": "0.1.0",
  "private": true,
  "description": "Plataforma de gestión de centro deportivo (pública, socios y gestión interna)",
  "packageManager": "pnpm@9.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "api:migrate": "pnpm --filter @localsports/api prisma migrate dev",
    "api:seed": "pnpm --filter @localsports/api prisma db seed"
  },
  "devDependencies": {
    "turbo": "^2.0.0",
    "prettier": "^3.3.0",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=20"
  }
}
